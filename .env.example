# Render Postgres 주소 (로컬: External, Render 서버: Internal)
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME
# 이 앱이 쓰는 DB 공간(스키마) 이름. 다른 과제와 섞이지 않게 분리
DB_SCHEMA=level3
PORT=4001
# 허용할 프론트엔드 주소 (쉼표로 여러 개 가능)
FRONTEND_URL=http://localhost:3001
# 로그인 토큰 서명용 비밀 문자열 (길고 아무도 모르게)
JWT_SECRET=change-me
# OpenAI API 키 (AI 기능용, 백엔드에만 둔다)
GPT_API_KEY=sk-...
GPT_MODEL=gpt-4o-mini
